<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Shugyo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_dark</item>
        <!-- Web pages get their normal light look (some class sites turn text invisible in dark mode). -->
        <item name="android:isLightTheme">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="window_dark">#FF0E0D0C</color>
</resources>
